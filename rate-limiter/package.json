{
  "name": "rate-limiter",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed rate limiter: token bucket and sliding window, in memory and on Redis",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "tsx --env-file-if-exists=.env --test",
    "test:watch": "tsx --env-file-if-exists=.env --test --watch",
    "typecheck": "tsc -p . --noEmit",
    "bench": "tsx --env-file-if-exists=.env bench/run.ts"
  },
  "dependencies": {
    "ioredis": "5.4.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.5",
    "@types/node": "22.10.0",
    "autocannon": "7.15.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
